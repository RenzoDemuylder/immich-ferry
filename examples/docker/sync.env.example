# Copy to sync.env and chmod 600. Do not commit.
IMMICH_A_URL=https://photos-a.example.com
IMMICH_B_URL=https://photos-b.example.com
IMMICH_A_API_KEY=replace-me
IMMICH_B_API_KEY=replace-me
# Which albums to sync. EITHER one album pair by UUID (the last part of the album URL in Immich):
SYNC_A_ALBUM_ID=11111111-1111-1111-1111-111111111111
SYNC_B_ALBUM_ID=22222222-2222-2222-2222-222222222222
# OR album discovery (remove the two ids above): every album the user can edit ...
# SYNC_DISCOVERY=all
# ... or only albums whose description contains a marker (on either side). Albums are paired by name;
# a missing counterpart is created.
# SYNC_DISCOVERY=marker
# SYNC_DISCOVERY_MARKER=🔁
# Created albums belong to the API key's user; share them with people on that side (emails or user ids):
# SYNC_DISCOVERY_SHARE_A=alice@example.com
# SYNC_DISCOVERY_SHARE_B=bob@example.com,carol@example.com
# SYNC_DISCOVERY_SHARE_ROLE=editor
# When everyone a created album was shared with leaves it, the sync user leaves the original album, deletes the
# created one and stops syncing (key needs album.delete + albumUser.delete). Also trash the photos it uploaded there
# (only those in no other album it can see; a member's own albums are invisible to it, so this is off by default):
# SYNC_DISCOVERY_TEARDOWN_TRASH=false
# The API key's user is a dedicated service account that owns no albums of its own: never re-pair an album
# everyone left, even if the state directory is lost.
# SYNC_DISCOVERY_DEDICATED_USER=false
SYNC_INTERVAL=15m
# Start with a dry run if you like:
# SYNC_DRY_RUN=true
# SYNC_TMP_BUDGET=17179869184
LOG_LEVEL=info
LOG_FORMAT=json
